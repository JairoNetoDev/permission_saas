# Lido pelo Docker Compose, que repassa estes valores aos containers (profile prod).
# Rodando as aplicações na máquina (profile dev), nada aqui é necessário: o
# application-dev.yml de cada uma já tem valores padrão. O Spring Boot não lê este arquivo.

# Usuário e senha do Swagger UI da aplicação principal.
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin123

# OAuth2/JWT não são usados pelo fluxo implementado (fora de escopo), mas o
# profile prod exige um valor não vazio para a aplicação subir.
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret
JWT_SECRET=change-this-secret

# Porta da máquina em que o Compose publica o banco da aplicação principal (default 5432).
# Descomente se um PostgreSQL instalado na máquina já ocupa a 5432.
# POSTGRES_HOST_PORT=5434
