            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"{{apiKey}}\",\n  \"projectId\": \"{{projectId}}\",\n  \"role\": \"ADMIN\",\n  \"httpMethod\": \"GET\",\n  \"route\": \"/relatorios\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/validate-permission",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "validate-permission"
              ]
            }
          }
        },
        {
          "name": "12. Validar permissao (negado — cargo nao cadastrado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('negado', () => pm.expect(pm.response.json().granted).to.eql(false));",
