                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"{{apiKey}}\",\n  \"projectId\": \"{{projectId}}\",\n  \"role\": \"SEM_ACESSO\",\n  \"httpMethod\": \"GET\",\n  \"route\": \"/users\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/validate-permission",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "validate-permission"
              ]
            }
          }
        },
        {
          "name": "14. Consultar a trilha de auditoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audit-events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audit-events"
              ]
