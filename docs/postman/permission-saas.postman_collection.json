            "description": "Deve conter os dois eventos gerados pelas validacoes acima."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('registrou as validacoes', () => pm.expect(pm.response.json().length).to.be.above(1));"
                ]
              }
            }
          ]
        }
      ]
    },
