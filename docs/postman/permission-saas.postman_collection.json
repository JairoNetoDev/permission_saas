{
  "info": {
    "name": "Permission SaaS",
    "description": "Colecao de requisicoes da API do Permission SaaS.\n\nOrdem sugerida: execute a pasta 'Fluxo completo' de cima para baixo — cada requisicao guarda em variaveis de colecao o que a proxima precisa (clientId, planId, apiKey, projectId).\n\nVariavel baseUrl: http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clientId",
      "value": ""
    },
    {
      "key": "planId",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "errorProjectId",
      "value": ""
    },
    {
      "key": "roleId",
      "value": ""
    },
    {
      "key": "routeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Fluxo completo",
      "item": [
        {
          "name": "1. Ping",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ping",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ping"
              ]
            },
            "description": "Verifica se a aplicacao esta no ar."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Registrar cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jairo Neto\",\n  \"email\": \"jairo.{{$timestamp}}@example.com\",\n  \"rawPassword\": \"secret123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/clients/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients",
                "register"
              ]
            },
            "description": "Cria o cliente dono dos projetos."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('clientId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Cadastrar plano",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pro {{$timestamp}}\",\n  \"description\": \"Plano usado nos testes\",\n  \"maxProjects\": 10,\n  \"maxUsersPerProject\": 50,\n  \"price\": 99.90\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/plans",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "plans"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// POST /plans devolve 200, e nao 201 como os demais recursos — ver docs/API.md",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('planId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Assinar plano (gera a ApiKey)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"planId\": \"{{planId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/subscriptions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "subscriptions"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('apiKey', pm.response.json().apiKey);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Criar projeto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"name\": \"Portal do Cliente\",\n  \"description\": \"Projeto criado pela colecao\",\n  \"maxRoles\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('devolve Location', () => pm.response.to.have.header('Location'));",
                  "pm.collectionVariables.set('projectId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Adicionar cargo ao projeto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ADMIN\",\n  \"description\": \"Acesso total\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "roles"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('roleId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Adicionar rota ao projeto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Listar usuarios\",\n  \"path\": \"/users\",\n  \"httpMethod\": \"GET\",\n  \"description\": \"Listagem paginada\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/routes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "routes"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('routeId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Conceder a rota ao cargo (RoleRoute)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('concessao ativa', () => pm.expect(pm.response.json().active).to.eql(true));",
                  "pm.test('sem data de revogacao', () => pm.expect(pm.response.json().revokedAt).to.eql(null));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/roles/{{roleId}}/routes/{{routeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "roles",
                "{{roleId}}",
                "routes",
                "{{routeId}}"
              ]
            }
          }
        },
        {
          "name": "9. Validar permissao (permitido)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"{{apiKey}}\",\n  \"projectId\": \"{{projectId}}\",\n  \"role\": \"ADMIN\",\n  \"httpMethod\": \"GET\",\n  \"route\": \"/users\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/validate-permission",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "validate-permission"
              ]
            },
            "description": "Passa pela cadeia de handlers e publica o evento consumido pela auditoria."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('permitido', () => pm.expect(pm.response.json().granted).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "10. Validar permissao (negado — ApiKey invalida)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('negado', () => pm.expect(pm.response.json().granted).to.eql(false));",
                  "pm.test('motivo correto', () => pm.expect(pm.response.json().reason).to.eql('invalid or inactive api key'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"chave-invalida\",\n  \"projectId\": \"{{projectId}}\",\n  \"role\": \"ADMIN\",\n  \"httpMethod\": \"GET\",\n  \"route\": \"/users\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/validate-permission",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "validate-permission"
              ]
            }
          }
        },
        {
          "name": "11. Validar permissao (negado — rota nao cadastrada)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('negado', () => pm.expect(pm.response.json().granted).to.eql(false));",
