          "name": "12b. Setup — cargo sem nenhuma concessao",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"SEM_ACESSO\",\n  \"description\": \"Cargo criado sem concessao de rota\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/roles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "roles"
              ]
            }
          }
        },
        {
          "name": "13. Validar permissao (negado — cargo sem concessao na rota)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('negado', () => pm.expect(pm.response.json().granted).to.eql(false));",
