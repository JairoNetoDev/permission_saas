            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"{{apiKey}}\",\n  \"projectId\": \"{{projectId}}\",\n  \"role\": \"FINANCEIRO\",\n  \"httpMethod\": \"GET\",\n  \"route\": \"/users\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/validate-permission",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "validate-permission"
              ]
            }
          }
        },
